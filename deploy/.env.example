# RavenScale full-stack deploy config. Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && ./install.sh          # production
#   ./install.sh --dev                            # hermetic (bundled MinIO)

# ============================ control plane ============================

# SWAP POINT. Default is upstream Headscale as a health-checkable stand-in until
# P0-2 ships the RavenScale fork image. Point this at the fork image when ready.
RAVENSCALE_IMAGE=ghcr.io/juanfont/headscale:v0.26.1

# The URL clients connect to. MUST be reachable by clients and MUST NOT share a
# host with HS_BASE_DOMAIN. For a real deploy use your https:// endpoint.
HS_SERVER_URL=http://127.0.0.1:8080

# MagicDNS base domain (ADR-0004). Must differ from HS_SERVER_URL's host.
HS_BASE_DOMAIN=ravenscale.internal

# Host bind for the control-plane API (the one public surface).
HS_BIND=0.0.0.0:8080
# Metrics/debug bind — keep private. Loopback by default.
HS_METRICS_BIND=127.0.0.1:9090

# ============================== datastore =============================
# (consumed by deploy/datastore via compose `include`)

# sqld image tag. Pin to a digest/tag in production; do not run :latest live.
SQLD_VERSION=latest
# Where sqld's HTTP port is published on the host. Loopback by default, and on
# 8081 so it does not collide with the control plane's 8080. The app reaches
# sqld over the compose network (sqld:8080); this host publish is for admin,
# drills, and the install/upgrade health probe. Only bind to a routable address
# if SQLD_AUTH_JWT_KEY is set.
SQLD_BIND=127.0.0.1:8081

# --- S3 (or S3-compatible) target for WAL backups ---
# For --dev these are ignored/overridden to point at the bundled MinIO.
S3_BUCKET=ravenscale-db
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- datastore auth ---
# Ed25519 public key verifying client JWTs. EMPTY = sqld is OPEN to anyone who
# can reach the port. Set before the port is reachable by anything but the app.
SQLD_AUTH_JWT_KEY=
