# RavenScale datastore config. Copy to .env and fill in. Never commit .env.

# sqld image tag. Pin to a digest/tag in production; do not run :latest live.
SQLD_VERSION=latest

# Where sqld's HTTP port is published on the host. Loopback by default.
# Only bind to a routable address if SQLD_AUTH_JWT_KEY is set.
SQLD_BIND=127.0.0.1:8080

# --- S3 (or S3-compatible) target for WAL backups ---
S3_BUCKET=ravenscale-db
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- auth ---
# Ed25519 public key (PEM or URL-safe base64) used to verify client JWTs.
# EMPTY = the datastore is OPEN to anyone who can reach the port. Set this
# before the port is reachable by anything but the app.
SQLD_AUTH_JWT_KEY=
